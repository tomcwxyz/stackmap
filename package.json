{
  "name": "stackmap",
  "version": "0.3.0",
  "private": true,
  "description": "Lightweight architecture mapping for social purpose organisations",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:app && python -m mkdocs build -d out/docs",
    "build:app": "next build --webpack",
    "build:docs": "python -m mkdocs build -d out/docs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "autoprefixer": "^10.4.27",
    "mermaid": "^11.17.2",
    "next": "^16.4.3",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.72.0",
    "tailwindcss": "^3.4.19",
    "uuid": "^13.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
